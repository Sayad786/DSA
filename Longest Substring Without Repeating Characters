"""
LeetCode 3: Longest Substring Without Repeating Characters

Given a string s, find the length of the longest substring
without repeating characters.

------------------------------------------------
Approach: Sliding Window (Variable Size)
------------------------------------------------
Idea:
- Use two pointers (left and right)
- Maintain a set of characters in the current window
- Expand window by moving right pointer
- If duplicate character appears, shrink window from left
- Track the maximum window length

Time Complexity: O(n)
Space Complexity: O(n)
"""


class Solution:
    def lengthOfLongestSubstring(self, s):

        # Set to store characters in current window
        char_set = set()

        # Left pointer of sliding window
        left = 0

        # Maximum length of valid substring
        max_length = 0

        # Right pointer moves through the string
        for right in range(len(s)):

            # If character already exists, shrink window
            while s[right] in char_set:
                char_set.remove(s[left])
                left += 1

            # Add current character to set
            char_set.add(s[right])

            # Update maximum window length
            max_length = max(max_length, right - left + 1)

        return max_length


# ---------------- Local Testing ----------------
if __name__ == "__main__":
    s = "pwwkew"
    print("Longest Substring Length:", Solution().lengthOfLongestSubstring(s))
