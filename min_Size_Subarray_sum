"""
LeetCode 209: Minimum Size Subarray Sum

Given an array of positive integers and a target value,
find the minimal length of a contiguous subarray
of which the sum is greater than or equal to target.

If no such subarray exists, return 0.

------------------------------------------------
Approach: Sliding Window (Variable Size)
------------------------------------------------
Idea:
- Use two pointers (left and right)
- Expand window by moving right pointer and adding to sum
- When sum >= target, shrink window from left
- Track the minimum window size

Time Complexity: O(n)
Space Complexity: O(1)
"""


class Solution:
    def minSubArrayLen(self, target, nums):

        # Left pointer of sliding window
        left = 0

        # Current sum of window
        current_sum = 0

        # Initialize minimum length to infinity
        min_length = float('inf')

        # Right pointer moves through the array
        for right in range(len(nums)):

            # Add current element to window sum
            current_sum += nums[right]

            # Shrink window while sum is valid
            while current_sum >= target:

                # Update minimum window size
                min_length = min(min_length, right - left + 1)

                # Remove element at left pointer
                current_sum -= nums[left]
                left += 1

        # If min_length was not updated, return 0
        return 0 if min_length == float('inf') else min_length


# ---------------- Local Testing ----------------
if __name__ == "__main__":
    target = 7
    nums = [2, 3, 1, 2, 4, 3]

    print("Minimum Subarray Length:", Solution().minSubArrayLen(target, nums))
